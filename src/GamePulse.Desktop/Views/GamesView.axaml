<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:GamePulse.Desktop.Services"
             xmlns:text="using:GamePulse.Desktop.Resources"
             xmlns:controls="using:GamePulse.Desktop.Controls"
             x:Class="GamePulse.Desktop.Views.GamesView">
  <controls:AdaptivePageGrid RowDefinitions="Auto,*,Auto" RowSpacing="12" Margin="0,4,0,0">
    <ScrollViewer Classes="adaptiveHeader" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="{loc:Translate Module=Strings, Key=PageControls}">
      <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" Margin="0,0,10,0">
    <StackPanel Spacing="4">
      <TextBlock Text="{loc:Translate Module=Games, Key=Title}" AutomationProperties.HeadingLevel="1" FontSize="25" FontWeight="SemiBold" />
      <TextBlock Text="{loc:Translate Module=Games, Key=Subtitle}" Classes="muted" FontSize="12" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,*,*" ColumnSpacing="12">
      <Border Classes="card" Padding="16,12">
        <StackPanel Spacing="5"><TextBlock Text="{loc:Translate Module=Games, Key=Returned}" Classes="label" FontSize="10" />
          <TextBlock Text="{Binding AvailableCount}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card" Padding="16,12">
        <StackPanel Spacing="5"><TextBlock Text="{loc:Translate Module=Games, Key=TotalHours}" Classes="label" FontSize="10" />
          <TextBlock Text="{Binding TotalHours}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card" Padding="16,12">
        <StackPanel Spacing="5"><TextBlock Text="{loc:Translate Module=Games, Key=Unplayed}" Classes="label" FontSize="10" />
          <TextBlock Text="{Binding UnplayedCount}" FontSize="22" FontWeight="SemiBold" /></StackPanel>
      </Border>
    </Grid>

    <StackPanel Grid.Row="2" Spacing="7">
      <TextBlock Text="{Binding LibraryCompleteness}" Classes="muted" FontSize="11" />
      <TextBlock Text="{Binding PlaytimeCoverage}" Classes="label" FontSize="11" />
      <TabControl SelectedIndex="{Binding SelectedModeIndex, Mode=TwoWay}" Height="40" Padding="0" Background="Transparent">
        <TabItem Header="{loc:Translate Module=Games, Key=Library}" />
        <TabItem Header="{loc:Translate Module=Games, Key=Recent}" />
      </TabControl>
    </StackPanel>

    <StackPanel Grid.Row="3" Spacing="8">
      <Grid ColumnDefinitions="*,184" ColumnSpacing="10">
        <TextBox x:Name="GamesFilterInput" AutomationProperties.AutomationId="GamesFilterInput" Text="{Binding Query, Mode=TwoWay}" PlaceholderText="{loc:Translate Module=Games, Key=Search}"
                 AutomationProperties.Name="{loc:Translate Module=Games, Key=Search}" MinHeight="38"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 PlaceholderForeground="{DynamicResource MutedTextBrush}" />
        <ComboBox Grid.Column="1" ItemsSource="{Binding SortOptions}" SelectedIndex="{Binding SelectedSortIndex, Mode=TwoWay}"
                  HorizontalAlignment="Stretch" VerticalContentAlignment="Center"
                  AutomationProperties.Name="{loc:Translate Module=Games, Key=Sort}" >
            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Value}" /></DataTemplate></ComboBox.ItemTemplate>
          </ComboBox>
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <TextBox Text="{Binding MinimumHours, Mode=TwoWay}" PlaceholderText="{loc:Translate Module=Games, Key=Minimum}"
                 AutomationProperties.Name="{loc:Translate Module=Games, Key=Minimum}" Width="104" Margin="0,0,8,0"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 PlaceholderForeground="{DynamicResource MutedTextBrush}" />
        <TextBox Text="{Binding MaximumHours, Mode=TwoWay}" PlaceholderText="{loc:Translate Module=Games, Key=Maximum}"
                 AutomationProperties.Name="{loc:Translate Module=Games, Key=Maximum}" Width="104" Margin="0,0,15,0"
                 Background="{DynamicResource InputBrush}" Foreground="{DynamicResource TextBrush}"
                 PlaceholderForeground="{DynamicResource MutedTextBrush}" />
        <CheckBox Content="{loc:Translate Module=Games, Key=NeverPlayed}" IsChecked="{Binding UnplayedOnly, Mode=TwoWay}"
                  IsEnabled="{Binding CanFilterUnplayed}" Margin="0,0,16,0" />
        <Button Content="{loc:Translate Module=Games, Key=Reset}" Command="{Binding ResetFiltersCommand}" Classes="quiet" FontSize="12" />
      </WrapPanel>
    </StackPanel>

    <StackPanel Grid.Row="4" Spacing="5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <controls:LiveStatusTextBlock x:Name="GamesStatus" AutomationProperties.AutomationId="GamesStatus" Text="{Binding ActiveStateMessage}" AutomationProperties.LiveSetting="Polite" Classes="muted" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding ShownCount}" Classes="label" FontSize="11" />
      </Grid>
      <TextBlock Text="{loc:Translate Module=Games, Key=RecentNote}" Classes="muted" FontSize="11" IsVisible="{Binding ShowRecent}" />
      <ProgressBar Height="2" IsIndeterminate="True" IsVisible="{Binding ActiveLoading}" />
    </StackPanel>

      </Grid>
    </ScrollViewer>
    <!-- The finite * row and the ListBox's own scroll viewer preserve virtualization. -->
    <Border Grid.Row="1" CornerRadius="9" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
            Background="{DynamicResource CardBrush}" ClipToBounds="True">
      <Grid RowDefinitions="30,*">
        <Grid ColumnDefinitions="*,104,116,104" Margin="14,0,24,0" VerticalAlignment="Center">
          <TextBlock Text="{loc:Translate Module=Games, Key=Game}" Classes="label" FontSize="10" />
          <TextBlock Grid.Column="1" Text="{loc:Translate Module=Games, Key=Lifetime}" Classes="label" FontSize="10" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="2" Text="{loc:Translate Module=Games, Key=TwoWeeks}" Classes="label" FontSize="10" HorizontalAlignment="Right" />
          <TextBlock Grid.Column="3" Text="{loc:Translate Module=Games, Key=LastPlayed}" Classes="label" FontSize="10" HorizontalAlignment="Right" />
        </Grid>
        <ListBox x:Name="GamesList" AutomationProperties.AutomationId="GamesList" Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                 KeyDown="GamesList_OnKeyDown" AutomationProperties.Name="{loc:Translate Module=Games, Key=Title}"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="{loc:Translate Module=Games, Key=Store}" Click="OpenStore_OnClick" />
              <MenuItem Header="{loc:Translate Module=Games, Key=Copy}" Click="CopyAppId_OnClick" />
            </ContextMenu>
          </ListBox.ContextMenu>
          <ListBox.ItemsPanel><ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,6" /><Setter Property="MinHeight" Value="52" /><Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" /></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Grid ColumnDefinitions="*,104,116,104" Height="40" VerticalAlignment="Center">
                <StackPanel Spacing="3" VerticalAlignment="Center" Margin="0,0,12,0">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                  <TextBlock Text="{Binding AppId}" Classes="label" FontSize="10" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Lifetime}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12" />
                <TextBlock Grid.Column="2" Text="{Binding Recent}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="muted" FontSize="12" />
                <TextBlock Grid.Column="3" Text="{Binding LastPlayed}" HorizontalAlignment="Right" VerticalAlignment="Center" Classes="muted" FontSize="11" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </Border>

    <Grid Grid.Row="2" RowDefinitions="Auto,Auto" RowSpacing="8">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock Text="{Binding ActiveUpdatedAt}" Classes="label" FontSize="10" />
          <TextBlock Text="{loc:Translate Module=Games, Key=SelectHint}" Classes="muted" FontSize="10" IsVisible="{Binding !HasSelection}" />
          <controls:LiveStatusTextBlock x:Name="GamesLocalMessage" AutomationProperties.AutomationId="GamesLocalMessage" Text="{Binding LocalMessage}" AutomationProperties.LiveSetting="Polite" Classes="muted" FontSize="11" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{loc:Translate Module=Games, Key=Copy}" Click="CopyAppId_OnClick" IsEnabled="{Binding HasSelection}" FontSize="12" />
          <Button Content="{loc:Translate Module=Games, Key=Store}" Click="OpenStore_OnClick" IsEnabled="{Binding HasSelection}" Classes="primary" FontSize="12" />
        </StackPanel>
      </Grid>
      <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="14">
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5"><TextBlock Text="{loc:Translate Module=Games, Key=OwnedStatusLabel}" Classes="label" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding OwnedStatus}" Classes="muted" FontSize="10" /></Grid>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="5"><TextBlock Text="{loc:Translate Module=Games, Key=RecentStatusLabel}" Classes="label" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding RecentStatus}" Classes="muted" FontSize="10" /></Grid>
      </Grid>
    </Grid>
  </controls:AdaptivePageGrid>
</UserControl>
